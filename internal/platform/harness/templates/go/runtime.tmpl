func xlGraphNode(p *xlParser) *Node {
	adj := xlSlice(p, func(p *xlParser) []int { return xlSlice(p, xlInt) })
	if len(adj) == 0 {
		return nil
	}
	nodes := make([]*Node, len(adj))
	for i := range nodes {
		nodes[i] = &Node{Val: i + 1}
	}
	for i, row := range adj {
		for _, k := range row {
			if k < 1 || k > len(adj) {
				xlFail("bad_input")
			}
			nodes[i].Neighbors = append(nodes[i].Neighbors, nodes[k-1])
		}
	}
	return nodes[0]
}

func xlEncGraphNode(w *xlWriter, start *Node) {
	if start == nil {
		w.b = append(w.b, '[', ']')
		return
	}
	byVal := map[int]*Node{}
	seen := map[*Node]bool{start: true}
	q := []*Node{start}
	for i := 0; i < len(q); i++ {
		n := q[i]
		w.node()
		if byVal[n.Val] != nil {
			xlFail("invalid_graph")
		}
		byVal[n.Val] = n
		for _, m := range n.Neighbors {
			if m == nil {
				xlFail("invalid_graph")
			}
			if !seen[m] {
				seen[m] = true
				q = append(q, m)
			}
		}
	}
	w.b = append(w.b, '[')
	for v := 1; v <= len(q); v++ {
		n := byVal[v]
		if n == nil {
			xlFail("invalid_graph")
		}
		if v > 1 {
			w.b = append(w.b, ',')
		}
		w.b = append(w.b, '[')
		for j, m := range n.Neighbors {
			if j > 0 {
				w.b = append(w.b, ',')
			}
			w.b = strconv.AppendInt(w.b, int64(m.Val), 10)
		}
		w.b = append(w.b, ']')
	}
	w.b = append(w.b, ']')
}
