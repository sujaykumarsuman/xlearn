type xlHarnessErr string

func xlFail(code string) { panic(xlHarnessErr(code)) }

const xlMaxNodes = 1000000

func xlReadInput() []byte {
	f := os.NewFile(3, "input")
	if f == nil {
		xlFail("bad_input")
	}
	var h [4]byte
	if _, err := io.ReadFull(f, h[:]); err != nil {
		xlFail("bad_input")
	}
	n := uint32(h[0])<<24 | uint32(h[1])<<16 | uint32(h[2])<<8 | uint32(h[3])
	if n > 64<<20 {
		xlFail("bad_input")
	}
	b := make([]byte, n)
	if _, err := io.ReadFull(f, b); err != nil {
		xlFail("bad_input")
	}
	return b
}

func xlWriteFrame(payload []byte) {
	f := os.NewFile(4, "result")
	if f == nil {
		os.Exit(98)
	}
	n := len(payload)
	out := append([]byte{byte(n >> 24), byte(n >> 16), byte(n >> 8), byte(n)}, payload...)
	if _, err := f.Write(out); err != nil {
		os.Exit(98)
	}
	_ = f.Close()
}

func xlPanicClass(r any) string {
	e, ok := r.(error)
	if !ok {
		return "other"
	}
	if _, ok := r.(interface{ RuntimeError() }); !ok {
		return "other"
	}
	m := e.Error()
	switch {
	case strings.Contains(m, "index out of range"):
		return "index_out_of_range"
	case strings.Contains(m, "slice bounds out of range"):
		return "slice_bounds"
	case strings.Contains(m, "nil pointer dereference"):
		return "nil_dereference"
	case strings.Contains(m, "integer divide by zero"):
		return "divide_by_zero"
	case strings.Contains(m, "assignment to entry in nil map"):
		return "nil_map_write"
	}
	return "other"
}

func xlRecover() {
	r := recover()
	if r == nil {
		return
	}
	if he, ok := r.(xlHarnessErr); ok {
		xlWriteFrame([]byte(`{"error":"` + string(he) + `"}`))
	} else {
		xlWriteFrame([]byte(`{"panic":"` + xlPanicClass(r) + `"}`))
	}
	os.Exit(0)
}

type xlParser struct {
	b []byte
	i int
}

func (p *xlParser) ws() {
	for p.i < len(p.b) && (p.b[p.i] == ' ' || p.b[p.i] == '\t' || p.b[p.i] == '\n' || p.b[p.i] == '\r') {
		p.i++
	}
}

func (p *xlParser) peek() byte {
	p.ws()
	if p.i >= len(p.b) {
		xlFail("bad_input")
	}
	return p.b[p.i]
}

func (p *xlParser) expect(c byte) {
	if p.peek() != c {
		xlFail("bad_input")
	}
	p.i++
}

func (p *xlParser) end() {
	p.ws()
	if p.i != len(p.b) {
		xlFail("bad_input")
	}
}

func (p *xlParser) lit(s string) bool {
	p.ws()
	if len(p.b)-p.i >= len(s) && string(p.b[p.i:p.i+len(s)]) == s {
		p.i += len(s)
		return true
	}
	return false
}

func (p *xlParser) null() bool { return p.lit("null") }

func (p *xlParser) numText() string {
	p.ws()
	s := p.i
	for p.i < len(p.b) {
		c := p.b[p.i]
		if (c >= '0' && c <= '9') || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E' {
			p.i++
			continue
		}
		break
	}
	if s == p.i {
		xlFail("bad_input")
	}
	return string(p.b[s:p.i])
}

func (p *xlParser) i64(lo, hi int64) int64 {
	n, err := strconv.ParseInt(p.numText(), 10, 64)
	if err != nil || n < lo || n > hi {
		xlFail("bad_input")
	}
	return n
}

func (p *xlParser) hex4() rune {
	if p.i+4 > len(p.b) {
		xlFail("bad_input")
	}
	n, err := strconv.ParseUint(string(p.b[p.i:p.i+4]), 16, 32)
	if err != nil {
		xlFail("bad_input")
	}
	p.i += 4
	return rune(n)
}

// skip passes over one JSON value.
func (p *xlParser) skip(depth int) {
	if depth > 64 {
		xlFail("bad_input")
	}
	switch c := p.peek(); {
	case c == '"':
		xlString(p)
	case c == '[' || c == '{':
		p.i++
		closeB := byte(']')
		if c == '{' {
			closeB = '}'
		}
		if p.peek() == closeB {
			p.i++
			return
		}
		for {
			if c == '{' {
				xlString(p)
				p.expect(':')
			}
			p.skip(depth + 1)
			if p.peek() == ',' {
				p.i++
				continue
			}
			p.expect(closeB)
			return
		}
	case c == 't':
		if !p.lit("true") {
			xlFail("bad_input")
		}
	case c == 'f':
		if !p.lit("false") {
			xlFail("bad_input")
		}
	case c == 'n':
		if !p.null() {
			xlFail("bad_input")
		}
	default:
		p.numText()
	}
}

func xlInt(p *xlParser) int     { return int(p.i64(math.MinInt32, math.MaxInt32)) }
func xlInt64(p *xlParser) int64 { return p.i64(math.MinInt64, math.MaxInt64) }

func xlFloat(p *xlParser) float64 {
	f, err := strconv.ParseFloat(p.numText(), 64)
	if err != nil || math.IsInf(f, 0) || math.IsNaN(f) {
		xlFail("bad_input")
	}
	return f
}

func xlBool(p *xlParser) bool {
	switch {
	case p.lit("true"):
		return true
	case p.lit("false"):
		return false
	}
	xlFail("bad_input")
	return false
}

func xlString(p *xlParser) string {
	p.expect('"')
	var out []byte
	for {
		if p.i >= len(p.b) {
			xlFail("bad_input")
		}
		c := p.b[p.i]
		p.i++
		switch {
		case c == '"':
			if !utf8.Valid(out) {
				xlFail("bad_input")
			}
			return string(out)
		case c == '\\':
			if p.i >= len(p.b) {
				xlFail("bad_input")
			}
			e := p.b[p.i]
			p.i++
			switch e {
			case '"', '\\', '/':
				out = append(out, e)
			case 'b':
				out = append(out, '\b')
			case 'f':
				out = append(out, '\f')
			case 'n':
				out = append(out, '\n')
			case 'r':
				out = append(out, '\r')
			case 't':
				out = append(out, '\t')
			case 'u':
				r := p.hex4()
				if r >= 0xd800 && r < 0xdc00 {
					if p.i+6 > len(p.b) || p.b[p.i] != '\\' || p.b[p.i+1] != 'u' {
						xlFail("bad_input")
					}
					p.i += 2
					r2 := p.hex4()
					if r2 < 0xdc00 || r2 > 0xdfff {
						xlFail("bad_input")
					}
					r = (r-0xd800)<<10 | (r2 - 0xdc00) + 0x10000
				}
				out = utf8.AppendRune(out, r)
			default:
				xlFail("bad_input")
			}
		case c < 0x20:
			xlFail("bad_input")
		default:
			out = append(out, c)
		}
	}
}

func xlSlice[T any](p *xlParser, f func(*xlParser) T) []T {
	p.expect('[')
	out := []T{}
	if p.peek() == ']' {
		p.i++
		return out
	}
	for {
		out = append(out, f(p))
		if p.peek() == ',' {
			p.i++
			continue
		}
		p.expect(']')
		return out
	}
}

// xlSpans splits an array into its elements' raw bytes.
func xlSpans(p *xlParser) [][]byte {
	p.expect('[')
	out := [][]byte{}
	if p.peek() == ']' {
		p.i++
		return out
	}
	for {
		p.ws()
		s := p.i
		p.skip(1)
		out = append(out, p.b[s:p.i])
		if p.peek() == ',' {
			p.i++
			continue
		}
		p.expect(']')
		return out
	}
}

type xlWriter struct {
	b     []byte
	nodes int
}

func (w *xlWriter) raw(s string) { w.b = append(w.b, s...) }

func (w *xlWriter) node() {
	w.nodes++
	if w.nodes > xlMaxNodes {
		xlFail("too_many_nodes")
	}
}

func xlEncInt(w *xlWriter, v int)     { w.b = strconv.AppendInt(w.b, int64(v), 10) }
func xlEncInt64(w *xlWriter, v int64) { w.b = strconv.AppendInt(w.b, v, 10) }
func xlEncBool(w *xlWriter, v bool)   { w.b = strconv.AppendBool(w.b, v) }

func xlEncFloat(w *xlWriter, v float64) {
	if math.IsNaN(v) || math.IsInf(v, 0) {
		xlFail("non_finite")
	}
	if v == 0 {
		w.b = append(w.b, '0')
		return
	}
	w.b = strconv.AppendFloat(w.b, v, 'g', -1, 64)
}

func xlEncString(w *xlWriter, v string) {
	if !utf8.ValidString(v) {
		xlFail("invalid_utf8")
	}
	const hex = "0123456789abcdef"
	w.b = append(w.b, '"')
	for i := 0; i < len(v); i++ {
		c := v[i]
		switch {
		case c == '"' || c == '\\':
			w.b = append(w.b, '\\', c)
		case c < 0x20:
			w.b = append(w.b, '\\', 'u', '0', '0', hex[c>>4], hex[c&0xf])
		default:
			w.b = append(w.b, c)
		}
	}
	w.b = append(w.b, '"')
}

func xlEncSlice[T any](w *xlWriter, v []T, f func(*xlWriter, T)) {
	w.b = append(w.b, '[')
	for i, e := range v {
		if i > 0 {
			w.b = append(w.b, ',')
		}
		f(w, e)
	}
	w.b = append(w.b, ']')
}
