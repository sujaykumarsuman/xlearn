func xlListNode(p *xlParser) *ListNode {
	vals := xlSlice(p, xlInt)
	var head *ListNode
	for i := len(vals) - 1; i >= 0; i-- {
		head = &ListNode{Val: vals[i], Next: head}
	}
	return head
}

func xlEncListNode(w *xlWriter, head *ListNode) {
	seen := map[*ListNode]bool{}
	w.b = append(w.b, '[')
	for n := head; n != nil; n = n.Next {
		if seen[n] {
			xlFail("cycle")
		}
		seen[n] = true
		w.node()
		if n != head {
			w.b = append(w.b, ',')
		}
		w.b = strconv.AppendInt(w.b, int64(n.Val), 10)
	}
	w.b = append(w.b, ']')
}
{{end}}{{if .UsesTree}}
func xlTreeNode(p *xlParser) *TreeNode {
	vals := xlSlice(p, func(p *xlParser) *int {
		if p.null() {
			return nil
		}
		v := xlInt(p)
		return &v
	})
	if len(vals) == 0 || vals[0] == nil {
		return nil
	}
	root := &TreeNode{Val: *vals[0]}
	q := []*TreeNode{root}
	for i := 1; len(q) > 0 && i < len(vals); {
		n := q[0]
		q = q[1:]
		if vals[i] != nil {
			n.Left = &TreeNode{Val: *vals[i]}
			q = append(q, n.Left)
		}
		i++
		if i < len(vals) && vals[i] != nil {
			n.Right = &TreeNode{Val: *vals[i]}
			q = append(q, n.Right)
		}
		i++
	}
	return root
}

func xlEncTreeNode(w *xlWriter, root *TreeNode) {
	if root == nil {
		w.b = append(w.b, '[', ']')
		return
	}
	seen := map[*TreeNode]bool{}
	q := []*TreeNode{root}
	for i := 0; i < len(q); i++ {
		n := q[i]
		if n == nil {
			continue
		}
		if seen[n] {
			xlFail("cycle")
		}
		seen[n] = true
		w.node()
		q = append(q, n.Left, n.Right)
	}
	end := len(q)
	for end > 0 && q[end-1] == nil {
		end--
	}
	w.b = append(w.b, '[')
	for i := 0; i < end; i++ {
		if i > 0 {
			w.b = append(w.b, ',')
		}
		if q[i] == nil {
			w.b = append(w.b, "null"...)
		} else {
			w.b = strconv.AppendInt(w.b, int64(q[i].Val), 10)
		}
	}
	w.b = append(w.b, ']')
}
