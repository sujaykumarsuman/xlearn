// Bellman-Ford bounded to k stops (k+1 edges).
dist := make([]int, n)
for i := range dist {
    dist[i] = math.MaxInt32
}
dist[src] = 0
for i := 0; i <= k; i++ {
    tmp := append([]int(nil), dist...)
    for _, f := range flights { // f = [from, to, price]
        if dist[f[0]] != math.MaxInt32 && dist[f[0]]+f[2] < tmp[f[1]] {
            tmp[f[1]] = dist[f[0]] + f[2]
        }
    }
    dist = tmp
}